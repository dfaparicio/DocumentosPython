# =============================================
# Configuración del Sistema de Extracción de Documentos
# =============================================

# API Key de Google Gemini (OBLIGATORIO)
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Gemini a usar (gemini-2.5-flash es el recomendado)
GEMINI_MODEL=gemini-2.5-flash

# Configuración de rendimiento
MAX_CONCURRENT_AI_REQUESTS=5
AI_REQUEST_TIMEOUT=30
DEFAULT_DPI=100

# Logging
LOG_LEVEL=INFO

# Seguridad / CORS
# Lista de orígenes permitidos separados por coma (ej. en producción: https://midominio.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:9000,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:9000
